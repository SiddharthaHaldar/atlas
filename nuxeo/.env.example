# ── Oracle XE 11g container ───────────────────────────────────────────────────
ORACLE_CONTAINER_PORT=1521
ORACLE_SID=XE
ORACLE_SYSTEM_PASSWORD=        # SYS / SYSTEM password inside the container

# N6 schema (Nuxeo 6 writes here)
ORACLE_USER=                   # e.g. NUXEO_OWNER
ORACLE_PASSWORD=               # schema user password

# N7 schema (populated by clone script, Nuxeo 7.10 reads from here)
ORACLE_USER7=                  # e.g. NUXEO_OWNER7
ORACLE_PASSWORD7=              # schema user password

# ── Nuxeo ports ───────────────────────────────────────────────────────────────
NUXEO6_PORT=8080
NUXEO7_PORT=8081

# ── Nuxeo public URLs (used to generate internal links) ───────────────────────
# Local:  http://localhost:8080/nuxeo
# GCP:    https://8080-CHANGE_ME.cloudshell.dev/nuxeo
NUXEO6_URL=
NUXEO7_URL=
